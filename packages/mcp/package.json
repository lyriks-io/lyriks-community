{
  "name": "@lyriks/mcp",
  "version": "0.9.22",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ee.mjs ensure && tsx watch src/index.ts",
    "build": "node scripts/ee.mjs ensure && node ./build.mjs",
    "typecheck": "node scripts/ee.mjs ensure && tsc --noEmit --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "node scripts/ee.mjs ensure && vitest run",
    "test:watch": "vitest",
    "test:oss-boundary": "node --test scripts/oss-boundary.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.34",
    "jose": "^5.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "license": "AGPL-3.0-only"
}
