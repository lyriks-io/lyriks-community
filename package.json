{
  "name": "lyriks",
  "version": "0.9.48",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:community": "node scripts/dev-edition.mjs community",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "icons:build": "node scripts/build-icon-subset.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "audit:unspa": "node scripts/audit-unspa-integrity.mjs",
    "audit:unspa:json": "node scripts/audit-unspa-integrity.mjs --json",
    "audit:unspa:strict": "node scripts/audit-unspa-integrity.mjs --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oss-boundary": "node --test scripts/oss-boundary.test.mjs",
    "test:dev-editions": "node --test scripts/dev-edition.test.mjs",
    "test:unspa-integrity": "node --test scripts/lib/unspa-integrity.test.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "playwright test",
    "test:socket-origin": "node --test scripts/lib/socket-origin.test.mjs",
    "dev:mcp": "pnpm --filter @lyriks/mcp dev",
    "check:mcp": "pnpm --filter @lyriks/mcp typecheck",
    "test:mcp": "pnpm --filter @lyriks/mcp test && pnpm --filter @lyriks/mcp test:oss-boundary",
    "build:mcp": "pnpm --filter @lyriks/mcp build"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@iconify/svelte": "^5.2.4",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "bcryptjs": "^3.0.3",
    "d3-force": "3.0.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.15",
    "marked": "^18.1.3",
    "mermaid": "^11.16.1",
    "pg": "^8.23.1",
    "unspaghettit": "^0.27.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.33"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.8",
      "devalue": "5.9.3",
      "tsx>esbuild": "0.28.1",
      "fast-uri": "3.1.7",
      "proxy-addr": "2.0.8",
      "@modelcontextprotocol/sdk": "1.32.2",
      "ip-address": "10.3.1",
      "@hono/node-server": "1.19.15",
      "body-parser@>=2 <2.4": "2.4.0",
      "dompurify@<3.4.17": "3.4.17",
      "zod@<4.6.6": "4.6.7",
      "qs": "6.16.0"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyriks-io/lyriks-community.git"
  },
  "homepage": "https://lyriks.io"
}
