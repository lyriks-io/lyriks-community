engine-strict=false
# Don't run an implicit `pnpm install` before `pnpm dev`/scripts. The dev launcher
# (run-lyriks.sh) rsyncs source from the Windows working copy, which bumps
# package.json's mtime; without this, pnpm 11 would try to reinstall on every
# launch and abort the dev server. Deps are installed explicitly by the launcher.
verify-deps-before-run=false
