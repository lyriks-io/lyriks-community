# Lyriks Community. Copy to `.env` and adjust.
#
# Two audiences share this file: `docker compose up` reads the first block,
# `pnpm dev:community` reads the rest. Nothing below is required for
# development: the platform runs fully offline with none set.

# ── docker compose ────────────────────────────────────────────────────────
# The two secrets the stack cannot start without (generate them once):
#   openssl rand -hex 16   for POSTGRES_PASSWORD
#   openssl rand -hex 32   for LYRIKS_JWT_SECRET (32 characters at least)
# POSTGRES_PASSWORD=
# LYRIKS_JWT_SECRET=
# The address people and MCP clients reach the platform on, and the port.
# LYRIKS_PUBLIC_ORIGIN=http://localhost:3000
# LYRIKS_HTTP_PORT=3000
# LYRIKS_BIND=127.0.0.1
# Where the images come from: this repository's builds on GHCR at this tree's
# version by default; the appliance channel is registry.lyriks.io/community
# at `stable`; images you built yourself, whatever you named them.
# LYRIKS_REGISTRY=ghcr.io/lyriks-io
# LYRIKS_TAG=

# ── pnpm dev:community ────────────────────────────────────────────────────

# PostgreSQL is required in every edition.
LYRIKS_PG_URL=postgres://lyriks:dev@localhost:5432/lyriks_platform

# `pnpm dev:community` sets the edition and starts the behaviour dashboard on
# port 3005 (3001 is usually taken by a local appliance). Plain `pnpm dev`
# reads the variables below directly.
# LYRIKS_EDITION=community
# UNSPA_DASHBOARD_PORT=3005

# The MCP gateway (`pnpm dev:mcp`, packages/mcp) the dev server proxies /mcp to;
# unset, the platform serves nothing on /mcp.
LYRIKS_MCP_URL=http://127.0.0.1:3001

# Authentication: every declared edition requires the operator login, and only
# `vite dev` is exempt. For a build that declares no edition, 1 walls it.
# LYRIKS_AUTH_REQUIRED=0

# Product activation (offline licence key, verified locally with the bundled
# public key). A `vite dev` boot is exempt so development needs no key.
# LYRIKS_LICENSE_REQUIRED=0
# LYRIKS_LICENSE_PUBLIC_KEY=

# Update check: OFF by default (no network call). Set to 1 to let an admin be
# told when a newer release exists; it asks the registry the install pulls
# from, which is the LYRIKS_REGISTRY set in the compose block above (set that
# one, not a second copy here: the last definition in this file wins).
# LYRIKS_UPDATE_CHECK=0
# LYRIKS_VERSION=

# Behaviour engine: the unspaghettit MCP binary is resolved from the installed
# npm package; set only to run a local checkout. The kernel store defaults to
# data/unspa relative to the process cwd.
# UNSPAGHETTIT_MCP_BIN=
# LYRIKS_UNSPA_ROOT=data/unspa

# AI cost governor, opt-in: wire an on-prem LiteLLM proxy with BOTH values.
# LITELLM_GATEWAY_URL=http://127.0.0.1:4000
# LITELLM_MASTER_KEY=
# LITELLM_CHEAP_MODEL=gpt-4o-mini
