node_modules/
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
!docs/deployment/.env.production.example
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# Local database files
*.db
*.db-shm
*.db-wal
/data

# Local Graphify tool + generated graph (rebuild with `pnpm graphify:code`)
/.graphify-tools/
/graphify-out/

# Per-machine / generated agent runtime config (re-create via `graphify install`).
# Shared agent guidance lives in the committed AGENTS.md + CLAUDE.md.
#
# EXCEPT the authoring skills: they are shared repo content, not per-machine
# config — the playbooks an agent follows to author Lyriks projects through the
# MCP. Ignore them and every checkout loses them, AND so does the appliance: the
# skill catalog is bundled at build time from this very directory, so a skill
# missing here is a skill no customer can ever sync. That is what happened to
# lyriks-retrospec, which existed only on its author's machine for four days.
# Every id in PUBLISHED_SKILL_IDS needs its line here; a test now enforces it.
/.claude/skills/*
!/.claude/skills/lyriks-build/
!/.claude/skills/lyriks-design/
!/.claude/skills/lyriks-behavior/
!/.claude/skills/lyriks-retrospec/
!/.claude/skills/lyriks-delivery/
/.claude/settings.local.json
/.codex/

# Licence signing keys — NEVER commit the private key (seller-side secret).
# The public key is embedded in-source; only the private half must stay out.
license-private.pem
*license*private*.pem
/secrets/

# Claude session scratchpad — verification screenshots (.png) & scripts, never commit
scratchpad/

# Playwright run output (failure dumps, traces, screenshots)
test-results/
!test-results/coherence-bars.png
playwright-report/

# Appliance kit runtime output: what the installer read off THIS machine. The
# directory and its README ship with the kit; the recorded facts never do.
/docs/deployment/lyriks-appliance/host/host.json

# Generated by `pnpm ee:link` from ee/ (the Enterprise overlay source).
/src/lib/ee/
/src/routes/(ee)/

# Local MCP connection files may carry live bearer credentials.
/.mcp.json
